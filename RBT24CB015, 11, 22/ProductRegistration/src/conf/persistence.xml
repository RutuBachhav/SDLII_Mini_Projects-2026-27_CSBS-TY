<?xml version="1.0" encoding="UTF-8"?>

<persistence version="3.0"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                        https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="ProductPU"
                      transaction-type="RESOURCE_LOCAL">

        <class>com.entity.Product</class>
        <class>com.entity.Category</class>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/product_db?createDatabaseIfNotExist=true&amp;useSSL=false&amp;serverTimezone=UTC"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="NewPassword123!"/>

            <!-- EclipseLink schema generation -->
            <property name="eclipselink.ddl-generation"
                      value="create-or-extend-tables"/>

            <property name="eclipselink.ddl-generation.output-mode"
                      value="database"/>

        </properties>

    </persistence-unit>

</persistence>
