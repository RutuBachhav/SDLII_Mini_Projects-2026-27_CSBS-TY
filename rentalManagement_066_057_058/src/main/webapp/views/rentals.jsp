<%@ page import="com.driveflow.store.DataStore" %><%@ page import="com.driveflow.model.*" %><%@ include file="layout.jspf" %>
<div class="page-head"><div><h2>Rentals</h2><p class="sub">Create bookings and return vehicles.</p></div></div>
<div class="modal"><div class="modal-head"><h3>Create Rental</h3><span class="sub">Only available vehicles can be rented.</span></div><form method="post" action="${pageContext.request.contextPath}/rentals"><div class="form-grid"><div class="form-group"><label>Vehicle</label><select name="vehicleId" required><%for(Vehicle v:DataStore.vehicles)if(v.getStatus()==Vehicle.Status.AVAILABLE){%><option value="<%=v.getId()%>"><%=v.getDisplayName()%> — ₹<%=String.format("%.0f",v.getDailyRate())%>/day</option><%}%></select></div><div class="form-group"><label>Customer</label><select name="customerId" required><%for(Customer c:DataStore.customers){%><option value="<%=c.getId()%>"><%=c.getName()%> — <%=c.getPhone()%></option><%}%></select></div><div class="form-group"><label>Start Date</label><input type="date" name="startDate" value="<%=java.time.LocalDate.now()%>" required></div><div class="form-group"><label>End Date</label><input type="date" name="endDate" value="<%=java.time.LocalDate.now().plusDays(1)%>" required></div></div><div style="margin-top:16px"><button class="btn btn-primary">Create Rental</button></div></form></div>
<div class="card"><div class="toolbar"><h3 style="margin:0">Rental History</h3><input class="search" data-filter="#rentalTable" placeholder="Search rentals..."></div><div class="table-wrap"><table class="table" id="rentalTable"><thead><tr><th>ID</th><th>Customer</th><th>Vehicle</th><th>Dates</th><th>Days</th><th>Total</th><th>Status</th><th>Action</th></tr></thead><tbody><%for(int i=DataStore.rentals.size()-1;i>=0;i--){Rental r=DataStore.rentals.get(i);Customer c=DataStore.customer(r.getCustomerId());Vehicle v=DataStore.vehicle(r.getVehicleId());%><tr><td>#<%=r.getId()%></td><td><%=c==null?"Unknown":c.getName()%></td><td><%=v==null?"Unknown":v.getDisplayName()%></td><td><%=r.getStartDate()%> → <%=r.getEndDate()%></td><td><%=r.getDays()%></td><td>₹<%=String.format("%.0f",r.getTotalAmount())%></td><td><span class="badge <%=r.getStatus().name().toLowerCase()%>"><%=r.getStatus()%></span></td><td><%if(r.getStatus()==Rental.Status.ACTIVE){%><a class="btn btn-small btn-primary" data-confirm="Mark this vehicle as returned?" href="${pageContext.request.contextPath}/rentals?action=return&id=<%=r.getId()%>">Return</a><%}else{%>—<%}%></td></tr><%}%></tbody></table></div></div>
<%@ include file="footer.jspf" %>
