<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>DriveFlow Login</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body><div class="login-page"><div class="login-box"><div class="brand"><span class="brand-mark">🚗</span>DriveFlow</div><h2>Welcome back</h2><p>Sign in to manage your rental fleet.</p><%if(request.getAttribute("error")!=null){%><div class="alert alert-error"><%=request.getAttribute("error")%></div><%}%><form method="post" action="${pageContext.request.contextPath}/login"><div class="form-group"><label>Username</label><input name="username" value="admin" required></div><div class="form-group"><label>Password</label><input name="password" type="password" value="admin123" required></div><button class="btn btn-primary" type="submit">Sign in</button></form><div class="hint"><b>Demo credentials:</b> admin / admin123</div></div></div></body></html>
