<%@ page import="com.driveflow.store.DataStore" %><%@ page import="com.driveflow.model.*" %><%@ include file="layout.jspf" %>
<div class="page-head"><div><h2>Payments</h2><p class="sub">Record and review rental payments.</p></div></div>
<div class="modal"><div class="modal-head"><h3>Record Payment</h3></div><form method="post" action="${pageContext.request.contextPath}/payments"><div class="form-grid"><div class="form-group"><label>Rental</label><select name="rentalId" required><%for(Rental r:DataStore.rentals){Customer c=DataStore.customer(r.getCustomerId());%><option value="<%=r.getId()%>">#<%=r.getId()%> — <%=c==null?"Unknown":c.getName()%> — ₹<%=String.format("%.0f",r.getTotalAmount())%></option><%}%></select></div><div class="form-group"><label>Amount (₹)</label><input name="amount" type="number" min="1" step="0.01" required></div><div class="form-group"><label>Payment Method</label><select name="method"><option>UPI</option><option>CARD</option><option>CASH</option><option>BANK_TRANSFER</option></select></div></div><div style="margin-top:16px"><button class="btn btn-primary">Record Payment</button></div></form></div>
<div class="card"><div class="toolbar"><h3 style="margin:0">Payment History</h3><input class="search" data-filter="#paymentTable" placeholder="Search payments..."></div><div class="table-wrap"><table class="table" id="paymentTable"><thead><tr><th>Payment</th><th>Rental</th><th>Customer</th><th>Amount</th><th>Method</th><th>Date</th><th>Status</th></tr></thead><tbody><%for(int i=DataStore.payments.size()-1;i>=0;i--){Payment p=DataStore.payments.get(i);Rental r=DataStore.rental(p.getRentalId());Customer c=r==null?null:DataStore.customer(r.getCustomerId());%><tr><td>#<%=p.getId()%></td><td>#<%=p.getRentalId()%></td><td><%=c==null?"Unknown":c.getName()%></td><td><b>₹<%=String.format("%.2f",p.getAmount())%></b></td><td><%=p.getMethod()%></td><td><%=p.getPaidAtText()%></td><td><span class="badge <%=p.getStatus().name().toLowerCase()%>"><%=p.getStatus()%></span></td></tr><%}%></tbody></table></div></div>
<%@ include file="footer.jspf" %>
