<%@ page import="java.util.*" %><%@ page import="com.driveflow.model.*" %><%@ page import="com.driveflow.store.DataStore" %><%@ include file="layout.jspf" %>
<div class="page-head"><div><h2>Vehicles</h2><p class="sub">Manage your fleet, pricing and availability.</p></div></div>
<% Vehicle editVehicle=(Vehicle)request.getAttribute("editVehicle"); if(editVehicle!=null){ %>
<div class="modal"><div class="modal-head"><h3>Edit Vehicle #<%=editVehicle.getId()%></h3><a class="btn btn-secondary btn-small" href="${pageContext.request.contextPath}/vehicles">Cancel</a></div><form method="post" action="${pageContext.request.contextPath}/vehicles"><input type="hidden" name="action" value="edit"><input type="hidden" name="id" value="<%=editVehicle.getId()%>"><div class="form-grid"><div class="form-group"><label>Registration No.</label><input name="registrationNo" value="<%=editVehicle.getRegistrationNo()%>" required></div><div class="form-group"><label>Brand</label><input name="brand" value="<%=editVehicle.getBrand()%>" required></div><div class="form-group"><label>Model</label><input name="model" value="<%=editVehicle.getModel()%>" required></div><div class="form-group"><label>Type</label><select name="type"><%for(String x:new String[]{"SUV","Sedan","Hatchback","MUV","Luxury"}){%><option <%=x.equals(editVehicle.getType())?"selected":""%>><%=x%></option><%}%></select></div><div class="form-group"><label>Fuel Type</label><select name="fuelType"><%for(String x:new String[]{"Petrol","Diesel","CNG","Electric","Hybrid"}){%><option <%=x.equals(editVehicle.getFuelType())?"selected":""%>><%=x%></option><%}%></select></div><div class="form-group"><label>Year</label><input name="year" type="number" value="<%=editVehicle.getYear()%>" required></div><div class="form-group"><label>Daily Rate (₹)</label><input name="dailyRate" type="number" min="1" step="0.01" value="<%=editVehicle.getDailyRate()%>" required></div><div class="form-group"><label>Status</label><select name="status"><%for(Vehicle.Status x:Vehicle.Status.values()){%><option <%=x==editVehicle.getStatus()?"selected":""%>><%=x%></option><%}%></select></div></div><div style="margin-top:16px"><button class="btn btn-primary">Save Changes</button></div></form></div>
<% } %>
<div class="modal"><div class="modal-head"><h3>Add Vehicle</h3><span class="sub">All fields are required</span></div><form method="post" action="${pageContext.request.contextPath}/vehicles"><div class="form-grid"><div class="form-group"><label>Registration No.</label><input name="registrationNo" placeholder="MH12AB1234" required></div><div class="form-group"><label>Brand</label><input name="brand" placeholder="Toyota" required></div><div class="form-group"><label>Model</label><input name="model" placeholder="Innova Crysta" required></div><div class="form-group"><label>Type</label><select name="type"><option>SUV</option><option>Sedan</option><option>Hatchback</option><option>MUV</option><option>Luxury</option></select></div><div class="form-group"><label>Fuel Type</label><select name="fuelType"><option>Petrol</option><option>Diesel</option><option>CNG</option><option>Electric</option><option>Hybrid</option></select></div><div class="form-group"><label>Year</label><input name="year" type="number" min="2000" max="2030" value="2026" required></div><div class="form-group"><label>Daily Rate (₹)</label><input name="dailyRate" type="number" min="1" step="0.01" placeholder="2500" required></div><div class="form-group"><label>Status</label><select name="status"><option>AVAILABLE</option><option>MAINTENANCE</option></select></div></div><div style="margin-top:16px"><button class="btn btn-primary">Add Vehicle</button></div></form></div>
<div class="card"><div class="toolbar"><h3 style="margin:0">Fleet <span class="sub">(<%=DataStore.vehicles.size()%>)</span></h3><input class="search" data-filter="#vehicleTable" placeholder="Search vehicles..."></div><div class="table-wrap"><table class="table" id="vehicleTable"><thead><tr><th>Vehicle</th><th>Registration</th><th>Type</th><th>Fuel</th><th>Year</th><th>Rate/day</th><th>Status</th><th>Actions</th></tr></thead><tbody><%for(Vehicle v:DataStore.vehicles){%><tr><td><b><%=v.getDisplayName()%></b></td><td><%=v.getRegistrationNo()%></td><td><%=v.getType()%></td><td><%=v.getFuelType()%></td><td><%=v.getYear()%></td><td>₹<%=String.format("%.0f",v.getDailyRate())%></td><td><span class="badge <%=v.getStatus().name().toLowerCase()%>"><%=v.getStatus()%></span></td><td><div class="actions"><a class="btn btn-small btn-secondary" href="${pageContext.request.contextPath}/vehicles?action=edit&id=<%=v.getId()%>">Edit</a><a class="btn btn-small btn-danger" data-confirm="Delete this vehicle?" href="${pageContext.request.contextPath}/vehicles?action=delete&id=<%=v.getId()%>">Delete</a></div></td></tr><%}%></tbody></table></div></div>
<%@ include file="footer.jspf" %>
