<%@ page import="java.util.*" %><%@ page import="com.driveflow.model.*" %><%@ include file="layout.jspf" %>
<div class="page-head"><div><h2>Dashboard</h2><p class="sub">Overview of your rental business.</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/rentals">+ New Rental</a></div>
<div class="cards"><div class="card stat"><div><div class="label">Available Vehicles</div><div class="value"><%=request.getAttribute("available")%></div></div><div class="iconbox">🚙</div></div><div class="card stat"><div><div class="label">Currently Rented</div><div class="value"><%=request.getAttribute("rented")%></div></div><div class="iconbox">🔑</div></div><div class="card stat"><div><div class="label">Customers</div><div class="value"><%=com.driveflow.store.DataStore.customers.size()%></div></div><div class="iconbox">👥</div></div><div class="card stat"><div><div class="label">Total Revenue</div><div class="value">₹<%=String.format("%.0f",(Double)request.getAttribute("revenue"))%></div></div><div class="iconbox">₹</div></div></div>
<div class="grid2"><div class="card"><h3>Recent Rentals</h3><div class="table-wrap"><table class="table"><thead><tr><th>ID</th><th>Customer</th><th>Vehicle</th><th>Period</th><th>Status</th><th>Amount</th></tr></thead><tbody><%List<Rental> rs=(List<Rental>)request.getAttribute("recentRentals");for(int i=rs.size()-1;i>=0&&i>=rs.size()-6;i--){Rental r=rs.get(i);Vehicle v=com.driveflow.store.DataStore.vehicle(r.getVehicleId());Customer c=com.driveflow.store.DataStore.customer(r.getCustomerId());%><tr><td>#<%=r.getId()%></td><td><%=c==null?"Unknown":c.getName()%></td><td><%=v==null?"Unknown":v.getDisplayName()%></td><td><%=r.getStartDate()%> → <%=r.getEndDate()%></td><td><span class="badge <%=r.getStatus().name().toLowerCase()%>"><%=r.getStatus()%></span></td><td>₹<%=String.format("%.0f",r.getTotalAmount())%></td></tr><%}%></tbody></table></div></div>
<div class="card"><h3>Fleet Status</h3><div class="metric-row"><div class="metric"><span class="label">Available</span><strong><%=request.getAttribute("available")%></strong></div><div class="metric"><span class="label">Rented</span><strong><%=request.getAttribute("rented")%></strong></div><div class="metric"><span class="label">Maintenance</span><strong><%=request.getAttribute("maintenance")%></strong></div></div><h3 style="margin-top:25px">Operations</h3><p class="sub">Active rentals: <b><%=request.getAttribute("active")%></b></p><p class="sub">Recorded payments: <b><%=com.driveflow.store.DataStore.payments.size()%></b></p></div></div>
<%@ include file="footer.jspf" %>
