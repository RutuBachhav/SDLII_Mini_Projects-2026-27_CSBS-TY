<%@ page import="com.driveflow.store.DataStore" %><%@ page import="com.driveflow.model.*" %><%@ include file="layout.jspf" %>
<div class="page-head"><div><h2>Reports & Analytics</h2><p class="sub">Operational snapshot from the current rental records.</p></div></div>
<div class="cards"><div class="card stat"><div><div class="label">Fleet Size</div><div class="value"><%=DataStore.vehicles.size()%></div></div><div class="iconbox">🚙</div></div><div class="card stat"><div><div class="label">Customers</div><div class="value"><%=DataStore.customers.size()%></div></div><div class="iconbox">👥</div></div><div class="card stat"><div><div class="label">Rentals</div><div class="value"><%=DataStore.rentals.size()%></div></div><div class="iconbox">📋</div></div><div class="card stat"><div><div class="label">Collected</div><div class="value">₹<%=String.format("%.0f",DataStore.revenue())%></div></div><div class="iconbox">₹</div></div></div>
<div class="grid2"><div class="card"><h3>Fleet Breakdown</h3><table class="table"><tbody><%for(Vehicle.Status s:Vehicle.Status.values()){int n=0;for(Vehicle v:DataStore.vehicles)if(v.getStatus()==s)n++;%><tr><td><span class="badge <%=s.name().toLowerCase()%>"><%=s%></span></td><td><b><%=n%></b> vehicles</td><td><%=DataStore.vehicles.size()==0?0:Math.round(n*10000.0/DataStore.vehicles.size())/100.0%>%</td></tr><%}%></tbody></table></div><div class="card"><h3>Rental Status</h3><table class="table"><tbody><%for(Rental.Status s:Rental.Status.values()){int n=0;for(Rental r:DataStore.rentals)if(r.getStatus()==s)n++;%><tr><td><span class="badge <%=s.name().toLowerCase()%>"><%=s%></span></td><td><b><%=n%></b> rentals</td></tr><%}%></tbody></table></div></div>
<%@ include file="footer.jspf" %>
