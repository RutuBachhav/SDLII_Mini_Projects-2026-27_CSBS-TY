<%@ page import="com.driveflow.store.DataStore" %><%@ page import="com.driveflow.model.*" %><%@ include file="layout.jspf" %>
<div class="page-head"><div><h2>Customers</h2><p class="sub">Maintain customer and driving-license information.</p></div></div>
<% Customer editCustomer=(Customer)request.getAttribute("editCustomer"); if(editCustomer!=null){ %>
<div class="modal"><div class="modal-head"><h3>Edit Customer #<%=editCustomer.getId()%></h3><a class="btn btn-secondary btn-small" href="${pageContext.request.contextPath}/customers">Cancel</a></div><form method="post" action="${pageContext.request.contextPath}/customers"><input type="hidden" name="action" value="edit"><input type="hidden" name="id" value="<%=editCustomer.getId()%>"><div class="form-grid"><div class="form-group"><label>Full Name</label><input name="name" value="<%=editCustomer.getName()%>" required></div><div class="form-group"><label>Email</label><input name="email" type="email" value="<%=editCustomer.getEmail()%>" required></div><div class="form-group"><label>Phone</label><input name="phone" value="<%=editCustomer.getPhone()%>" required></div><div class="form-group"><label>Driving License No.</label><input name="licenseNo" value="<%=editCustomer.getLicenseNo()%>" required></div><div class="form-group full"><label>Address</label><textarea name="address" rows="2" required><%=editCustomer.getAddress()%></textarea></div></div><div style="margin-top:16px"><button class="btn btn-primary">Save Changes</button></div></form></div>
<% } %>
<div class="modal"><div class="modal-head"><h3>Add Customer</h3></div><form method="post" action="${pageContext.request.contextPath}/customers"><div class="form-grid"><div class="form-group"><label>Full Name</label><input name="name" required></div><div class="form-group"><label>Email</label><input name="email" type="email" required></div><div class="form-group"><label>Phone</label><input name="phone" pattern="[0-9]{10}" maxlength="10" required></div><div class="form-group"><label>Driving License No.</label><input name="licenseNo" required></div><div class="form-group full"><label>Address</label><textarea name="address" rows="2" required></textarea></div></div><div style="margin-top:16px"><button class="btn btn-primary">Add Customer</button></div></form></div>
<div class="card"><div class="toolbar"><h3 style="margin:0">Customer Directory</h3><input class="search" data-filter="#customerTable" placeholder="Search customers..."></div><div class="table-wrap"><table class="table" id="customerTable"><thead><tr><th>ID</th><th>Name</th><th>Contact</th><th>License</th><th>Address</th><th>Actions</th></tr></thead><tbody><%for(Customer c:DataStore.customers){%><tr><td>#<%=c.getId()%></td><td><b><%=c.getName()%></b></td><td><%=c.getPhone()%><br><span class="sub"><%=c.getEmail()%></span></td><td><%=c.getLicenseNo()%></td><td><%=c.getAddress()%></td><td><a class="btn btn-small btn-secondary" href="${pageContext.request.contextPath}/customers?action=edit&id=<%=c.getId()%>">Edit</a><a class="btn btn-small btn-danger" data-confirm="Delete this customer?" href="${pageContext.request.contextPath}/customers?action=delete&id=<%=c.getId()%>">Delete</a></td></tr><%}%></tbody></table></div></div>
<%@ include file="footer.jspf" %>
