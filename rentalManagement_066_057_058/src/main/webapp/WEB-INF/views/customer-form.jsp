<%@ page import="java.util.*" %><%@ include file="includes/header.jspf" %><% Map c=(Map)request.getAttribute("customer");boolean edit=c!=null; %><div class="page-heading"><div><p class="eyebrow">CUSTOMER MANAGEMENT</p><h1><%=edit?"Edit customer":"Add customer"%></h1><p class="muted">Enter contact details and a unique licence number.</p></div><a class="btn ghost" href="${pageContext.request.contextPath}/customers">← Back</a></div><section class="panel form-panel"><form method="post" action="${pageContext.request.contextPath}/customers" class="form-grid" data-validate><input type="hidden" name="id" value="<%=edit?c.get("id"):""%>"><label>Full name *<input name="full_name" maxlength="120" required value="<%=edit?c.get("full_name"):""%>"></label><label>Phone *<input name="phone" maxlength="30" required value="<%=edit?c.get("phone"):""%>"></label><label>Email<input type="email" name="email" maxlength="160" value="<%=edit&&c.get("email")!=null?c.get("email"):""%>"></label><label>Driving licence number *<input name="license_number" maxlength="80" required value="<%=edit?c.get("license_number"):""%>"></label><label class="span-2">Address<textarea name="address" rows="3" maxlength="255"><%=edit&&c.get("address")!=null?c.get("address"):""%></textarea></label><div class="form-actions span-2"><a class="btn ghost" href="${pageContext.request.contextPath}/customers">Cancel</a><button class="btn primary">Save customer →</button></div></form></section><%@ include file="includes/footer.jspf" %>
