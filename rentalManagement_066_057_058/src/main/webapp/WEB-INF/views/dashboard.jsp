<%@ page import="java.util.*" %><%@ include file="includes/header.jspf" %><div class="page-heading"><div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1><p class="muted">A live snapshot of your rental operation.</p></div><a class="btn primary" href="${pageContext.request.contextPath}/rentals">＋ New booking</a></div><div class="stats-grid"><div class="stat-card"><span class="stat-icon purple">▣</span><span class="stat-label">Fleet vehicles</span><strong><%= ((Map)request.getAttribute("stats")).get("vehicles") %></strong><small><%= ((Map)request.getAttribute("stats")).get("available_vehicles") %> available now</small></div><div class="stat-card"><span class="stat-icon blue">♙</span><span class="stat-label">Active customers</span><strong><%= ((Map)request.getAttribute("stats")).get("customers") %></strong><small>Registered customers</small></div><div class="stat-card"><span class="stat-icon orange">▤</span><span class="stat-label">Open rentals</span><strong><%= ((Map)request.getAttribute("stats")).get("active_rentals") %></strong><small>Booked or currently active</small></div><div class="stat-card"><span class="stat-icon green">₹</span><span class="stat-label">Revenue this month</span><strong>₹<%= ((Map)request.getAttribute("stats")).get("monthly_revenue") %></strong><small>Payments received this month</small></div></div><section class="panel"><div class="panel-heading"><div><h2>Recent rentals</h2><p class="muted">Latest bookings from MySQL</p></div><a class="text-link" href="${pageContext.request.contextPath}/rentals">View all →</a></div><div class="table-wrap"><table><thead><tr><th>Rental</th><th>Customer</th><th>Vehicle</th><th>Start date</th><th>Status</th></tr></thead><tbody><% List<Map> recent=(List<Map>)request.getAttribute("recent");if(recent.isEmpty()){ %><tr><td colspan="5" class="empty">No rentals yet. Create your first booking.</td></tr><% }for(Map m:recent){ %><tr><td>#<%=m.get("id")%></td><td><%=m.get("customer")%></td><td><%=m.get("vehicle")%></td><td><%=m.get("date")%></td><td><span class="status <%=String.valueOf(m.get("status")).toLowerCase()%>"><%=m.get("status")%></span></td></tr><% } %></tbody></table></div></section><div class="quick-grid"><a class="quick-card" href="${pageContext.request.contextPath}/vehicles"><span>▣</span><strong>Manage fleet</strong><small>Add vehicles and update daily rates</small></a><a class="quick-card" href="${pageContext.request.contextPath}/customers"><span>♙</span><strong>Manage customers</strong><small>Maintain customer and licence records</small></a><a class="quick-card" href="${pageContext.request.contextPath}/payments"><span>₹</span><strong>Collect payment</strong><small>Record payment and track balances</small></a></div><%@ include file="includes/footer.jspf" %>
