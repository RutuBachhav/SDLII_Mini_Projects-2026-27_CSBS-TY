<%@ page import="java.util.*" %><%@ include file="includes/header.jspf" %><div class="page-heading"><div><p class="eyebrow">BUSINESS INTELLIGENCE</p><h1>Reports</h1><p class="muted">Rental totals and collected payments from persisted records.</p></div><button class="btn secondary" onclick="window.print()">Print report ↗</button></div><div class="stats-grid"><div class="stat-card"><span class="stat-label">Total vehicles</span><strong><%=((Map)request.getAttribute("stats")).get("vehicles")%></strong></div><div class="stat-card"><span class="stat-label">Customers</span><strong><%=((Map)request.getAttribute("stats")).get("customers")%></strong></div><div class="stat-card"><span class="stat-label">Open rentals</span><strong><%=((Map)request.getAttribute("stats")).get("active_rentals")%></strong></div><div class="stat-card"><span class="stat-label">Collected this month</span><strong>₹<%=((Map)request.getAttribute("stats")).get("monthly_revenue")%></strong></div></div><section class="panel"><div class="panel-heading"><div><h2>Rental financial summary</h2><p class="muted">Outstanding = total charge minus recorded payments (never below zero).</p></div></div><div class="table-wrap"><table><thead><tr><th>Rental</th><th>Customer</th><th>Vehicle</th><th>Rental dates</th><th>Status</th><th>Total charge</th><th>Paid</th><th>Outstanding</th></tr></thead><tbody><% List<Map> rows=(List<Map>)request.getAttribute("rows");if(rows.isEmpty()){ %><tr><td colspan="8" class="empty">No rental data available yet.</td></tr><% }for(Map m:rows){java.math.BigDecimal total=new java.math.BigDecimal(String.valueOf(m.get("total")));java.math.BigDecimal paid=new java.math.BigDecimal(String.valueOf(m.get("paid"))); %><tr><td>#<%=m.get("id")%></td><td><%=m.get("customer")%></td><td><%=m.get("vehicle")%></td><td><%=m.get("start")%><br><small class="muted">to <%=m.get("actual")==null?m.get("expected"):m.get("actual")%></small></td><td><span class="status <%=String.valueOf(m.get("status")).toLowerCase()%>"><%=m.get("status")%></span></td><td>₹<%=total%></td><td>₹<%=paid%></td><td><strong>₹<%=total.subtract(paid).max(java.math.BigDecimal.ZERO)%></strong></td></tr><% } %></tbody></table></div></section><%@ include file="includes/footer.jspf" %>
