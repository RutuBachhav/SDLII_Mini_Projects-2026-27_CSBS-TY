<%@ page import="java.util.*" %><%@ include file="includes/header.jspf" %><div class="page-heading"><div><p class="eyebrow">FLEET</p><h1>Vehicles</h1><p class="muted">Manage inventory, rates and availability.</p></div><a class="btn primary" href="${pageContext.request.contextPath}/vehicles?action=edit&id=0">＋ Add vehicle</a></div><form class="toolbar" method="get"><input name="q" value="<%=request.getParameter("q")==null?"":request.getParameter("q")%>" placeholder="Search registration, make or model"><button class="btn secondary">Search</button><a class="btn ghost" href="${pageContext.request.contextPath}/vehicles">Reset</a></form><section class="panel"><div class="table-wrap"><table><thead><tr><th>Vehicle</th><th>Registration</th><th>Type / Year</th><th>Daily rate</th><th>Status</th><th>Actions</th></tr></thead><tbody><% List<Map> list=(List<Map>)request.getAttribute("vehicles");if(list==null||list.isEmpty()){ %><tr><td colspan="6" class="empty">No vehicles found.</td></tr><% }else for(Map v:list){ %><tr><td><strong><%=v.get("make")%> <%=v.get("model")%></strong></td><td><%=v.get("registration_number")%></td><td><%=v.get("vehicle_type")%> · <%=v.get("model_year")%></td><td>₹<%=v.get("daily_rate")%></td><td><span class="status <%=String.valueOf(v.get("status")).toLowerCase()%>"><%=v.get("status")%></span></td><td class="actions"><a class="small-action" href="${pageContext.request.contextPath}/vehicles?action=edit&id=<%=v.get("id")%>">Edit</a><form method="post" class="inline-form" data-confirm="Deactivate this vehicle?" action="${pageContext.request.contextPath}/vehicles"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="id" value="<%=v.get("id")%>"><button class="small-action danger-text">Deactivate</button></form></td></tr><% } %></tbody></table></div></section><%@ include file="includes/footer.jspf" %>
