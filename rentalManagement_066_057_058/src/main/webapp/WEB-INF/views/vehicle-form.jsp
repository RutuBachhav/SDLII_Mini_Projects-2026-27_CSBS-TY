<%@ page import="java.util.*" %><%@ include file="includes/header.jspf" %><% Map v=(Map)request.getAttribute("vehicle");boolean edit=v!=null; %><div class="page-heading"><div><p class="eyebrow">FLEET MANAGEMENT</p><h1><%=edit?"Edit vehicle":"Add vehicle"%></h1><p class="muted">Keep vehicle details and rental pricing accurate.</p></div><a class="btn ghost" href="${pageContext.request.contextPath}/vehicles">← Back</a></div><section class="panel form-panel"><form method="post" action="${pageContext.request.contextPath}/vehicles" class="form-grid" data-validate><input type="hidden" name="id" value="<%=edit?v.get("id"):""%>"><label>Registration number *<input name="registration_number" required maxlength="30" value="<%=edit?v.get("registration_number"):""%>"></label><label>Make *<input name="make" required maxlength="80" value="<%=edit?v.get("make"):""%>"></label><label>Model *<input name="model" required maxlength="80" value="<%=edit?v.get("model"):""%>"></label><label>Vehicle type *<select name="vehicle_type" required><% String[] types={"Hatchback","Sedan","SUV","MUV","Luxury","Bike","Van","Other"};for(String t:types){ %><option <%=edit&&t.equals(v.get("vehicle_type"))?"selected":""%>><%=t%></option><% } %></select></label><label>Model year *<input type="number" name="model_year" min="1950" max="2100" required value="<%=edit?v.get("model_year"):"2025"%>"></label><label>Daily rate (₹) *<input type="number" name="daily_rate" min="0" step="0.01" required value="<%=edit?v.get("daily_rate"):""%>"></label><label>Status *<select name="status"><% String[] statuses={"AVAILABLE","RENTED","MAINTENANCE","INACTIVE"};for(String st:statuses){ %><option <%=edit&&st.equals(v.get("status"))?"selected":""%>><%=st%></option><% } %></select></label><label class="span-2">Notes<textarea name="notes" rows="3" maxlength="500"><%=edit&&v.get("notes")!=null?v.get("notes"):""%></textarea></label><div class="form-actions span-2"><a class="btn ghost" href="${pageContext.request.contextPath}/vehicles">Cancel</a><button class="btn primary">Save vehicle →</button></div></form></section><%@ include file="includes/footer.jspf" %>
