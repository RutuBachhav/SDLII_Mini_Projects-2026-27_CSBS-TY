<%@ page import="java.util.*" %><%@ include file="includes/header.jspf" %><div class="page-heading"><div><p class="eyebrow">VEHICLE HANDOVER</p><h1>Returns</h1><p class="muted">Complete a rental and calculate the final charge.</p></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Rental / Customer</th><th>Vehicle</th><th>Start date</th><th>Expected return</th><th>Status</th><th>Process return</th></tr></thead><tbody><% boolean any=false;for(Map m:(List<Map>)request.getAttribute("rentals")){if(!"ACTIVE".equals(m.get("status"))&& !"BOOKED".equals(m.get("status")))continue;any=true; %><tr><td>#<%=m.get("id")%> · <%=m.get("customer_name")%></td><td><%=m.get("registration_number")%></td><td><%=m.get("start_date")%></td><td><%=m.get("expected_return_date")%></td><td><span class="status <%=String.valueOf(m.get("status")).toLowerCase()%>"><%=m.get("status")%></span></td><td><form method="post" action="${pageContext.request.contextPath}/returns" class="return-form"><input type="hidden" name="rental_id" value="<%=m.get("id")%>"><input type="date" name="actual_return_date" value="<%=java.time.LocalDate.now()%>" required><button class="btn secondary small">Complete return</button></form></td></tr><% }if(!any){ %><tr><td colspan="6" class="empty">No bookings or active rentals need a return.</td></tr><% } %></tbody></table></div></section><div class="notice"><strong>Charge calculation</strong><p>Final rental charge = daily rate × number of rental days, counting both the start date and actual return date. Record payments separately in the Payments module.</p></div><%@ include file="includes/footer.jspf" %>
