<%@ page import="java.util.*" %><%@ include file="includes/header.jspf" %><div class="page-heading"><div><p class="eyebrow">CUSTOMER RELATIONSHIPS</p><h1>Customers</h1><p class="muted">Customer profiles and driving licence details.</p></div><a class="btn primary" href="${pageContext.request.contextPath}/customers?action=edit&id=0">＋ Add customer</a></div><form class="toolbar" method="get"><input name="q" value="<%=request.getParameter("q")==null?"":request.getParameter("q")%>" placeholder="Search name, phone, email or licence"><button class="btn secondary">Search</button><a class="btn ghost" href="${pageContext.request.contextPath}/customers">Reset</a></form><section class="panel"><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Phone / Email</th><th>Licence number</th><th>Address</th><th>Status</th><th>Actions</th></tr></thead><tbody><% List<Map> list=(List<Map>)request.getAttribute("customers");if(list==null||list.isEmpty()){ %><tr><td colspan="6" class="empty">No customers found.</td></tr><% }else for(Map c:list){ %><tr><td><strong><%=c.get("full_name")%></strong></td><td><%=c.get("phone")%><br><small class="muted"><%=c.get("email")==null?"—":c.get("email")%></small></td><td><%=c.get("license_number")%></td><td><%=c.get("address")==null?"—":c.get("address")%></td><td><span class="status <%=Boolean.TRUE.equals(c.get("active"))?"available":"inactive"%>"><%=Boolean.TRUE.equals(c.get("active"))?"ACTIVE":"INACTIVE"%></span></td><td class="actions"><a class="small-action" href="${pageContext.request.contextPath}/customers?action=edit&id=<%=c.get("id")%>">Edit</a><form method="post" class="inline-form" data-confirm="Deactivate this customer?" action="${pageContext.request.contextPath}/customers"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="id" value="<%=c.get("id")%>"><button class="small-action danger-text">Deactivate</button></form></td></tr><% } %></tbody></table></div></section><%@ include file="includes/footer.jspf" %>
