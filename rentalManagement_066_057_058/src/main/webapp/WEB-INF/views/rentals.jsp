<%@ page import="java.util.*" %><%@ include file="includes/header.jspf" %><div class="page-heading"><div><p class="eyebrow">BOOKING OPERATIONS</p><h1>Rentals</h1><p class="muted">Create bookings and track rental lifecycle.</p></div></div><section class="panel form-panel"><div class="panel-heading"><div><h2>New booking</h2><p class="muted">Estimated total includes both start and expected return dates.</p></div></div><form method="post" class="form-grid" data-validate><label>Customer *<select name="customer_id" required><option value="">Choose customer</option><% for(Map m:(List<Map>)request.getAttribute("customers")){ %><option value="<%=m.get("id")%>"><%=m.get("label")%></option><% } %></select></label><label>Available vehicle *<select name="vehicle_id" required><option value="">Choose vehicle</option><% for(Map m:(List<Map>)request.getAttribute("vehicles")){ %><option value="<%=m.get("id")%>"><%=m.get("label")%></option><% } %></select></label><label>Start date *<input type="date" name="start_date" min="<%=java.time.LocalDate.now()%>" required></label><label>Expected return *<input type="date" name="expected_return_date" min="<%=java.time.LocalDate.now()%>" required></label><label class="span-2">Notes<textarea name="notes" rows="2" maxlength="500"></textarea></label><div class="form-actions span-2"><button class="btn primary">Create booking →</button></div></form></section><section class="panel"><div class="panel-heading"><div><h2>All rentals</h2><p class="muted">Bookings, active rentals and completed returns.</p></div></div><div class="table-wrap"><table><thead><tr><th>ID / Customer</th><th>Vehicle</th><th>Dates</th><th>Estimate / Final</th><th>Paid</th><th>Status</th></tr></thead><tbody><% List<Map> list=(List<Map>)request.getAttribute("rentals");if(list.isEmpty()){ %><tr><td colspan="6" class="empty">No rentals have been created.</td></tr><% }for(Map m:list){ %><tr><td><strong>#<%=m.get("id")%> · <%=m.get("customer_name")%></strong></td><td><%=m.get("registration_number")%> · <%=m.get("make")%> <%=m.get("model")%></td><td><%=m.get("start_date")%><br><small class="muted">to <%=m.get("expected_return_date")%></small></td><td>₹<%=m.get("final_total")==null?m.get("estimated_total"):m.get("final_total")%></td><td>₹<%=m.get("paid")%></td><td><span class="status <%=String.valueOf(m.get("status")).toLowerCase()%>"><%=m.get("status")%></span></td></tr><% } %></tbody></table></div></section><%@ include file="includes/footer.jspf" %>
