<%@ page contentType="text/html; charset=UTF-8" %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · DriveFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body class="login-body"><div class="login-card"><a class="brand login-brand"><span class="brand-mark">D</span><span>DriveFlow<small>RENTAL MANAGER</small></span></a><p class="eyebrow">WELCOME BACK</p><h1>Sign in to your workspace</h1><p class="muted">Manage vehicles, bookings, returns and payments.</p><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%= String.valueOf(request.getAttribute("error")).replace("<","&lt;").replace(">","&gt;") %></div><% } %><form method="post" action="${pageContext.request.contextPath}/login" class="stack-form"><label>Username<input name="username" required autocomplete="username" placeholder="admin"></label><label>Password<input type="password" name="password" required autocomplete="current-password" placeholder="Enter password"></label><button class="btn primary full" type="submit">Sign in <span>→</span></button></form><div class="login-hint"><strong>Demo account</strong><span>Username: admin · Password: admin123</span><small>Change the demo password before using this app beyond a local demonstration.</small></div></div></body></html>
