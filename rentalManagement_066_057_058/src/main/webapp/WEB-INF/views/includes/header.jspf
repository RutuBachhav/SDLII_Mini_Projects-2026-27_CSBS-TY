<%@ page contentType="text/html; charset=UTF-8" %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>DriveFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/dashboard"><span class="brand-mark">D</span><span>DriveFlow<small>RENTAL MANAGER</small></span></a><nav><a href="${pageContext.request.contextPath}/dashboard">▦ <span>Dashboard</span></a><a href="${pageContext.request.contextPath}/vehicles">▣ <span>Vehicles</span></a><a href="${pageContext.request.contextPath}/customers">♙ <span>Customers</span></a><a href="${pageContext.request.contextPath}/rentals">▤ <span>Rentals</span></a><a href="${pageContext.request.contextPath}/returns">↩ <span>Returns</span></a><a href="${pageContext.request.contextPath}/payments">₹ <span>Payments</span></a><a href="${pageContext.request.contextPath}/reports">▥ <span>Reports</span></a></nav><div class="sidebar-bottom"><span class="online-dot"></span> MySQL connected app</div></aside><main class="main-content"><header class="topbar"><div><span class="eyebrow">OPERATIONS CONSOLE</span><strong>Vehicle rental management</strong></div><div class="user-menu"><span class="avatar">${sessionScope.user.fullName.substring(0,1)}</span><span>${sessionScope.user.fullName}</span><a class="logout" href="${pageContext.request.contextPath}/logout">Log out ↗</a></div></header><div class="page-content"><% if(request.getParameter("success")!=null){ %><div class="alert success">Saved successfully.</div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%= String.valueOf(request.getAttribute("error")).replace("<","&lt;").replace(">","&gt;") %></div><% } %>
