<%@ page import="java.util.*" %><%@ include file="includes/header.jspf" %><div class="page-heading"><div><p class="eyebrow">FINANCE</p><h1>Payments</h1><p class="muted">Record collections and review payment history.</p></div></div><section class="panel form-panel"><div class="panel-heading"><div><h2>Record payment</h2><p class="muted">Overpayments are rejected by the backend.</p></div></div><form method="post" class="form-grid" data-validate><label class="span-2">Rental with outstanding balance *<select name="rental_id" required><option value="">Choose rental</option><% for(Map m:(List<Map>)request.getAttribute("payableRentals")){ %><option value="<%=m.get("id")%>"><%=m.get("label")%></option><% } %></select></label><label>Amount (₹) *<input type="number" min="0.01" step="0.01" name="amount" required></label><label>Payment method *<select name="payment_method" required><option value="">Choose method</option><option>CASH</option><option>CARD</option><option>UPI</option><option>BANK_TRANSFER</option><option>OTHER</option></select></label><label>Reference number<input name="reference_number" maxlength="100"></label><label>Notes<input name="notes" maxlength="255"></label><div class="form-actions span-2"><button class="btn primary">Record payment →</button></div></form></section><section class="panel"><div class="panel-heading"><div><h2>Transaction history</h2><p class="muted">All payments recorded in MySQL.</p></div></div><div class="table-wrap"><table><thead><tr><th>Payment</th><th>Rental / Customer</th><th>Vehicle</th><th>Method</th><th>Reference</th><th>Amount</th><th>Paid at</th></tr></thead><tbody><% List<Map> list=(List<Map>)request.getAttribute("payments");if(list.isEmpty()){ %><tr><td colspan="7" class="empty">No payments recorded yet.</td></tr><% }for(Map m:list){ %><tr><td>#<%=m.get("id")%></td><td>#<%=m.get("rental_id")%> · <%=m.get("customer_name")%></td><td><%=m.get("registration_number")%></td><td><span class="status completed"><%=m.get("payment_method")%></span></td><td><%=m.get("reference_number")==null?"—":m.get("reference_number")%></td><td><strong>₹<%=m.get("amount")%></strong></td><td><%=m.get("paid_at")%></td></tr><% } %></tbody></table></div></section><%@ include file="includes/footer.jspf" %>
