<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             version="3.0"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="HostelPU" transaction-type="RESOURCE_LOCAL">

        <provider>
            org.eclipse.persistence.jpa.PersistenceProvider
        </provider>

        <class>com.mycompany.hostelmanagementsystem.entity.Users</class>
        <class>com.mycompany.hostelmanagementsystem.entity.Room</class>
        <class>com.mycompany.hostelmanagementsystem.entity.Student</class>
        <class>com.mycompany.hostelmanagementsystem.entity.FeePayment</class>
        <class>com.mycompany.hostelmanagementsystem.entity.Complaint</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/hostel_db?useSSL=false&amp;serverTimezone=Asia/Kolkata&amp;allowPublicKeyRetrieval=true"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="123456789"/>

            <property name="eclipselink.ddl-generation"
                      value="none"/>

            <property name="eclipselink.logging.level"
                      value="WARNING"/>

        </properties>

    </persistence-unit>

</persistence>

