<%@ page import="com.clothfactory.model.Product" %>
<%@ page import="com.clothfactory.util.HtmlEscaper" %>
<%@ page import="java.util.List" %>
<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<% List<Product> inventory = (List<Product>) request.getAttribute("inventory"); List<Product> lowStock = (List<Product>) request.getAttribute("lowStock"); %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Reports | Cloth Factory Inventory</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="<%= request.getContextPath() %>/assets/css/app.css" rel="stylesheet"></head>
<body><main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><p class="eyebrow mb-1">Analysis</p><h1 class="h2 mb-0">Inventory reports</h1></div><a class="btn btn-outline-dark" href="<%= request.getContextPath() %>/dashboard">Dashboard</a></div>
<section class="mb-5"><h2 class="h5">Current inventory</h2><div class="table-responsive bg-white shadow-sm"><table class="table table-hover mb-0"><thead><tr><th>Code</th><th>Product</th><th>Category</th><th>Available</th><th>Minimum</th><th>Unit price</th><th>Value</th></tr></thead><tbody><% for (Product product : inventory) { %><tr><td><%= HtmlEscaper.escape(product.getProductCode()) %></td><td><%= HtmlEscaper.escape(product.getProductName()) %></td><td><%= product.getCategory().name().replace('_', ' ') %></td><td><%= product.getCurrentQuantity() %> <%= HtmlEscaper.escape(product.getUnit()) %></td><td><%= product.getMinimumStock() %></td><td>&#8377; <%= product.getUnitPrice() %></td><td>&#8377; <%= product.getCurrentQuantity().multiply(product.getUnitPrice()) %></td></tr><% } %></tbody></table></div></section>
<section><h2 class="h5">Low-stock report</h2><div class="table-responsive bg-white shadow-sm"><table class="table table-hover mb-0"><thead><tr><th>Product</th><th>Available</th><th>Required minimum</th><th>Shortfall</th></tr></thead><tbody><% for (Product product : lowStock) { %><tr><td><%= HtmlEscaper.escape(product.getProductName()) %></td><td class="text-danger"><%= product.getCurrentQuantity() %> <%= HtmlEscaper.escape(product.getUnit()) %></td><td><%= product.getMinimumStock() %></td><td class="text-danger"><%= product.getMinimumStock().subtract(product.getCurrentQuantity()) %></td></tr><% } %><% if (lowStock.isEmpty()) { %><tr><td colspan="4" class="text-muted">No low-stock products.</td></tr><% } %></tbody></table></div></section></main></body></html>