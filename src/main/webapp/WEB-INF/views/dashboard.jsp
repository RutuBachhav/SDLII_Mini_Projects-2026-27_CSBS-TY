<%@ page import="com.clothfactory.model.DashboardData" %>
<%@ page import="com.clothfactory.model.Product" %>
<%@ page import="com.clothfactory.model.StockTransaction" %>
<%@ page import="com.clothfactory.util.HtmlEscaper" %>
<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<% DashboardData dashboard = (DashboardData) request.getAttribute("dashboard"); %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Dashboard | Cloth Factory Inventory</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="<%= request.getContextPath() %>/assets/css/app.css" rel="stylesheet"></head>
<body><main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap"><div><p class="eyebrow mb-1">Operations overview</p><h1 class="h2 mb-0">Dashboard</h1></div><div class="d-flex gap-2"><a class="btn btn-outline-dark" href="<%= request.getContextPath() %>/reports">Reports</a><a class="btn btn-dark" href="<%= request.getContextPath() %>/inventory/new?type=STOCK_IN">Record stock-in</a></div></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="bg-white p-3 shadow-sm"><small class="text-muted">Total products</small><div class="display-6 fw-bold"><%= dashboard.getTotalProducts() %></div></div></div><div class="col-md-3"><div class="bg-white p-3 shadow-sm"><small class="text-muted">Raw materials</small><div class="display-6 fw-bold"><%= dashboard.getRawMaterials() %></div></div></div><div class="col-md-3"><div class="bg-white p-3 shadow-sm"><small class="text-muted">Fabric products</small><div class="display-6 fw-bold"><%= dashboard.getFabricProducts() %></div></div></div><div class="col-md-3"><div class="bg-white p-3 shadow-sm"><small class="text-muted">Inventory value</small><div class="h3 fw-bold">&#8377; <%= dashboard.getInventoryValue() %></div></div></div></div>
<div class="row g-4"><section class="col-lg-6"><div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h5">Low-stock alerts</h2><a href="<%= request.getContextPath() %>/reports">View report</a></div><div class="table-responsive bg-white shadow-sm"><table class="table table-sm mb-0"><thead><tr><th>Product</th><th>Available</th><th>Minimum</th></tr></thead><tbody><% for (Product product : dashboard.getLowStockProducts()) { %><tr><td><%= HtmlEscaper.escape(product.getProductName()) %></td><td class="text-danger"><%= product.getCurrentQuantity() %> <%= HtmlEscaper.escape(product.getUnit()) %></td><td><%= product.getMinimumStock() %></td></tr><% } %><% if (dashboard.getLowStockProducts().isEmpty()) { %><tr><td colspan="3" class="text-muted">No low-stock products.</td></tr><% } %></tbody></table></div></section><section class="col-lg-6"><h2 class="h5 mb-2">Recent movements</h2><div class="table-responsive bg-white shadow-sm"><table class="table table-sm mb-0"><thead><tr><th>Product</th><th>Type</th><th>Qty</th></tr></thead><tbody><% for (StockTransaction transaction : dashboard.getRecentTransactions()) { %><tr><td><%= HtmlEscaper.escape(transaction.getProductName()) %></td><td><%= transaction.getType().name().replace('_', ' ') %></td><td><%= transaction.getQuantity() %></td></tr><% } %><% if (dashboard.getRecentTransactions().isEmpty()) { %><tr><td colspan="3" class="text-muted">No movements recorded.</td></tr><% } %></tbody></table></div></section></div></main></body></html>