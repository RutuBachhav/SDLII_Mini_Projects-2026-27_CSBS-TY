<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Expense Register</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body>
<header class="topbar"><div class="brand"><span class="mark">ER</span><span>Expense Register<small>Finance administration</small></span></div><div class="topnote">Expense management</div></header>
<main class="container"><div class="pagehead"><div><p class="eyebrow">RECORDS &amp; REPORTING</p><h1>Expenses</h1><p class="subhead">Track, review and maintain business spending.</p></div><div class="head-actions"><form class="currency-picker" method="post" action="${pageContext.request.contextPath}/expenses"><input type="hidden" name="action" value="currency"><label for="currency">Display currency<select id="currency" name="currency"><c:forEach items="${currencies}" var="option"><option value="${option.key}" ${currentCurrency==option.key?'selected':''}><c:out value="${option.key}"/> (<c:out value="${option.value}"/>)</option></c:forEach></select></label><button class="button secondary">Save</button></form><a class="button primary" href="#expense-form">+ Add expense</a></div></div>
<p class="currency-note">Currency is shared by this installation. Changing it updates the displayed symbol; amounts are not converted.</p>
<section class="summary" aria-label="Expense summary"><div><span>All-time spend</span><strong><span class="money-symbol"><c:out value="${currencySymbol}"/></span><fmt:formatNumber value="${total}" type="number" minFractionDigits="2" maxFractionDigits="2"/></strong></div><div><span>This month</span><strong><span class="money-symbol"><c:out value="${currencySymbol}"/></span><fmt:formatNumber value="${monthTotal}" type="number" minFractionDigits="2" maxFractionDigits="2"/></strong></div><div><span>Recorded expenses</span><strong><c:out value="${count}"/></strong></div></section>
<section class="panel insights"><div class="panelhead"><div><h2>Last month: <c:out value="${previousMonthLabel}"/></h2><p>Spending by category</p></div><div class="period-total"><span>Total</span><strong><span class="money-symbol"><c:out value="${currencySymbol}"/></span><fmt:formatNumber value="${previousMonthTotal}" type="number" minFractionDigits="2" maxFractionDigits="2"/></strong></div></div>
<c:choose><c:when test="${empty categorySpends}"><p class="chart-empty">No expenses were recorded last month.</p></c:when><c:otherwise><div class="bar-chart" role="list" aria-label="Last month's spending by category"><c:forEach var="spend" items="${categorySpends}"><div class="bar-row" role="listitem"><div class="bar-caption"><strong><c:out value="${spend.category}"/></strong><span><span class="money-symbol"><c:out value="${currencySymbol}"/></span><fmt:formatNumber value="${spend.amount}" type="number" minFractionDigits="2" maxFractionDigits="2"/> · <fmt:formatNumber value="${spend.sharePercent}" maxFractionDigits="1"/>%</span></div><div class="bar-track"><div class="bar-fill" style="width:${spend.sharePercent}%" role="img" aria-label="${spend.category}: ${spend.sharePercent} percent"></div></div></div></c:forEach></div></c:otherwise></c:choose></section>
<section class="panel"><div class="panelhead"><div><h2>Expense register</h2><p>Most recent expenses appear first.</p></div><form class="search" method="get" action="${pageContext.request.contextPath}/expenses"><label class="sr-only" for="q">Search expenses</label><input id="q" name="q" value="<c:out value='${param.q}'/>" placeholder="Search title or category"><button class="button secondary">Search</button><c:if test="${not empty param.q}"><a class="clear" href="${pageContext.request.contextPath}/expenses">Clear</a></c:if></form></div>
<div class="tablewrap"><table><thead><tr><th>Expense</th><th>Category</th><th>Date</th><th>Payment</th><th class="numeric">Amount</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>
<c:forEach var="e" items="${expenses}"><tr><td><strong><c:out value="${e.title}"/></strong><c:if test="${not empty e.description}"><small><c:out value="${e.description}"/></small></c:if></td><td><span class="tag"><c:out value="${e.category}"/></span></td><td><c:out value="${e.expenseDate}"/></td><td><c:out value="${e.paymentMethod}"/></td><td class="numeric amount"><span class="money-symbol"><c:out value="${currencySymbol}"/></span><fmt:formatNumber value="${e.amount}" type="number" minFractionDigits="2" maxFractionDigits="2"/></td><td class="actions"><a href="${pageContext.request.contextPath}/expenses?edit=${e.id}" class="action">Edit</a><form method="post" action="${pageContext.request.contextPath}/expenses" onsubmit="return confirm('Delete this expense?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${e.id}"><button class="action danger">Delete</button></form></td></tr></c:forEach>
<c:if test="${empty expenses}"><tr><td colspan="6" class="empty">No expenses found. Add an expense to begin your register.</td></tr></c:if></tbody></table></div></section>
<c:set var="formTitle" value="${not empty editing ? 'Edit expense' : 'Add an expense'}"/><section class="panel formpanel" id="expense-form"><div class="panelhead"><div><h2><c:out value="${formTitle}"/></h2><p>Enter the details below. Fields marked * are required.</p></div></div>
<form class="expenseform" method="post" action="${pageContext.request.contextPath}/expenses"><input type="hidden" name="action" value="${not empty editing ? 'update' : 'create'}"><c:if test="${not empty editing}"><input type="hidden" name="id" value="${editing.id}"></c:if>
<label>Title *<input name="title" maxlength="100" required value="<c:out value='${editing.title}'/>" placeholder="e.g. Client meeting lunch"></label><label>Amount *<div class="currency"><span><c:out value="${currencySymbol}"/></span><input name="amount" type="number" min="0.01" step="0.01" required value="${editing.amount}" placeholder="0.00"></div></label>
<label>Category *<select name="category" required><option value="">Select category</option><c:forEach items="${['Travel','Food','Meals','Office','Software','Utilities','Other']}" var="c"><option value="${c}" ${editing.category==c?'selected':''}><c:out value="${c}"/></option></c:forEach></select></label><label>Date *<input name="expenseDate" type="date" required value="${not empty editing ? editing.expenseDate : ''}"></label>
<label>Payment method *<select name="paymentMethod" required><option value="">Select method</option><c:forEach items="${['Cash','Card','Bank transfer','Other']}" var="m"><option value="${m}" ${editing.paymentMethod==m?'selected':''}><c:out value="${m}"/></option></c:forEach></select></label><label class="wide">Description<input name="description" maxlength="500" value="<c:out value='${editing.description}'/>" placeholder="Optional note"></label>
<div class="formactions"><button class="button primary">${not empty editing ? 'Save changes' : 'Save expense'}</button><c:if test="${not empty editing}"><a class="button secondary" href="${pageContext.request.contextPath}/expenses#expense-form">Cancel</a></c:if></div></form></section>
<footer>Expense Register <span>•</span> Internal finance records</footer></main></body></html>
