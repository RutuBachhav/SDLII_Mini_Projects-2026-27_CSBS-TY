<?xml version="1.0" encoding="UTF-8"?>
<!-- Turns on CDI bean discovery. "annotated" = only classes with a scope annotation
     (@ApplicationScoped, @SessionScoped, @RequestScoped...) or EJB annotation become beans.
     AuditInterceptor is enabled with @Priority, so it does not need to be listed here. -->
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                           https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
       version="4.0"
       bean-discovery-mode="annotated">
</beans>
